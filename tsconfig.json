{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "declaration": true,
    "strict": true,
    "isolatedModules": true,
    "strictNullChecks": true
  },
  "include": ["**/*.ts"]
}
